# ==========================================
# Godot 4+ Archivos Específicos
# ==========================================
# Ignora la carpeta oculta .godot. Aquí es donde el motor guarda
# los recursos importados, el caché de shaders y metadatos locales.
# NUNCA debe subirse al repositorio.
.godot/

# ==========================================
# Archivos de Exportación
# ==========================================
# Ignora las carpetas donde generarás tus binarios finales para
# Steam, PlayStore, etc. (ajusta los nombres si usas otros).
/export/
/builds/
/bin/

# ==========================================
# Archivos de Sistemas Operativos
# ==========================================
# Vital para el trabajo colaborativo. Evita que archivos basura
# de Windows o macOS de tus freelancers ensucien el repositorio.
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ==========================================
# Archivos de Copia de Seguridad de Editores Externos
# ==========================================
*~
*.swp
*.bak
*.tmp